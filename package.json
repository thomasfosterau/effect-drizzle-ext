{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-drizzle-ext-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the effect-drizzle-ext packages.",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@thomasfosterau/effect-drizzle-ext": "workspace:*",
    "@thomasfosterau/effect-drizzle-ext-pg": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "fallow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
