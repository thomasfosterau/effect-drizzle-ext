{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/tests/**/*.test.ts",
    "packages/pg/tests/integration/global-setup.ts",
    "packages/pg/vitest.integration.config.ts",
    "tests/dist-consumer/src/*.ts",
    "tests/dist-consumer/scripts/*.ts",
    "**/vite.config.ts",
    "vitest.coverage.config.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/docs/**"],
  "ignoreDependencies": ["@effect/language-service", "@typescript/native", "@effect/docgen"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/core/**"]
      },
      {
        "name": "pg",
        "patterns": ["packages/pg/**"]
      },
      {
        "name": "kit",
        "patterns": ["packages/kit/**"]
      },
      {
        "name": "dist-consumer",
        "patterns": ["tests/dist-consumer/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "pg",
        "allow": ["core"]
      },
      {
        "from": "kit",
        "allow": ["pg"]
      },
      {
        "from": "dist-consumer",
        "allow": ["core", "pg"]
      }
    ]
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
