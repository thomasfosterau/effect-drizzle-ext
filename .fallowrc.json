{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/core/src/index.ts",
    "packages/core/src/derive.ts",
    "packages/core/src/references.ts",
    "packages/core/src/constraints.ts",
    "packages/core/src/columns.ts",
    "packages/core/src/query.ts",
    "packages/core/src/sort.ts",
    "packages/core/src/update.ts",
    "packages/core/src/errors.ts",
    "packages/core/src/database.ts",
    "packages/core/src/versioned-chain.ts",
    "packages/core/src/jsonapi/index.ts",
    "packages/core/src/jsonapi/derive.ts",
    "packages/pg/src/index.ts",
    "packages/pg/src/migrations.ts",
    "packages/pg/src/testing.ts",
    "packages/pg/src/tooling/index.ts",
    "packages/*/tests/**/*.test.ts",
    "packages/pg/tests/integration/global-setup.ts",
    "packages/pg/vitest.integration.config.ts",
    "tests/dist-consumer/src/*.ts",
    "**/vite.config.ts",
    "vitest.coverage.config.ts"
  ],
  "ignorePatterns": ["**/dist/**", "**/coverage/**"],
  "ignoreDependencies": [
    "@types/node",
    "@effect/tsgo",
    "@effect/language-service",
    "@typescript/native",
    "typescript",
    "vite",
    "vitest",
    "vite-plus",
    "@changesets/cli",
    "@vitest/coverage-istanbul",
    "fallow"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "warn",
    "unused-enum-members": "error",
    "unused-class-members": "warn",
    "unresolved-imports": "error",
    "unlisted-dependencies": "error",
    "duplicate-exports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "stale-suppressions": "warn"
  },
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["packages/core/**"] },
      { "name": "pg", "patterns": ["packages/pg/**"] },
      { "name": "dist-consumer", "patterns": ["tests/dist-consumer/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "pg", "allow": ["core"] },
      { "from": "dist-consumer", "allow": ["core", "pg"] }
    ]
  },
  "audit": {
    "deadCodeBaseline": "fallow-baselines/dead-code.json"
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 30,
    "coverage": "coverage/coverage-final.json"
  }
}
