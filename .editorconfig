# Oxfmt reads this file too, so each value is Oxfmt's default: change the
# formatter in vite.config.ts first, then mirror it here.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Two trailing spaces are a Markdown hard line break, and Oxfmt keeps them.
[*.md]
trim_trailing_whitespace = false

# drizzle-kit's generated fixture chain, as drizzle-kit writes it.
[**/migrations/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
