{
  "name": "effect-drizzle-ext",
  // Tag follows the catalog's `vite-plus` pin.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.6.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {},
    // Lets `vp run test:integration` start its PostgreSQL via Testcontainers.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode", "EditorConfig.EditorConfig"]
    }
  },
  "workspaceFolder": "/workspaces/effect-drizzle-ext"
}
