{
  "name": "@thomasfosterau/effect-drizzle-ext-pg",
  "version": "0.9.0",
  "description": "The @effect/sql-pg binding for @thomasfosterau/effect-drizzle-ext: Database / CurrentTransaction services over drizzle-orm/effect-postgres, PgClient layers, a sentinel-rollback test runner with test-database provisioning, a fresh-database migration runner, typed helpers for PlanetScale's TIN full-text search, and migration-drift / view-dependency guards.",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "effect",
    "postgres",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-drizzle-ext#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-drizzle-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-drizzle-ext.git",
    "directory": "packages/pg"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Chain": "./src/Chain.ts",
    "./Documents": "./src/Documents.ts",
    "./ExternalIds": "./src/ExternalIds.ts",
    "./Migrations": "./src/Migrations.ts",
    "./Outbox": "./src/Outbox.ts",
    "./PgDatabase": "./src/PgDatabase.ts",
    "./Testing": "./src/Testing.ts",
    "./Tin": "./src/Tin.ts",
    "./Tooling": "./src/Tooling.ts",
    "./VersionedRow": "./src/VersionedRow.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Chain": {
        "types": "./dist/Chain.d.ts",
        "default": "./dist/Chain.js"
      },
      "./Documents": {
        "types": "./dist/Documents.d.ts",
        "default": "./dist/Documents.js"
      },
      "./ExternalIds": {
        "types": "./dist/ExternalIds.d.ts",
        "default": "./dist/ExternalIds.js"
      },
      "./Migrations": {
        "types": "./dist/Migrations.d.ts",
        "default": "./dist/Migrations.js"
      },
      "./Outbox": {
        "types": "./dist/Outbox.d.ts",
        "default": "./dist/Outbox.js"
      },
      "./PgDatabase": {
        "types": "./dist/PgDatabase.d.ts",
        "default": "./dist/PgDatabase.js"
      },
      "./Testing": {
        "types": "./dist/Testing.d.ts",
        "default": "./dist/Testing.js"
      },
      "./Tin": {
        "types": "./dist/Tin.d.ts",
        "default": "./dist/Tin.js"
      },
      "./Tooling": {
        "types": "./dist/Tooling.d.ts",
        "default": "./dist/Tooling.js"
      },
      "./VersionedRow": {
        "types": "./dist/VersionedRow.d.ts",
        "default": "./dist/VersionedRow.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-drizzle-ext": "workspace:^"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/vitest": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-pg": "catalog:peers",
    "@testcontainers/postgresql": "catalog:peers",
    "drizzle-kit": "catalog:peers",
    "drizzle-orm": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
