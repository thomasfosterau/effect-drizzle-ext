{
  "name": "@thomasfosterau/effect-drizzle-ext-pg",
  "version": "0.0.0",
  "description": "The @effect/sql-pg binding for @thomasfosterau/effect-drizzle-ext: Database / CurrentTransaction services over drizzle-orm/effect-postgres, PgClient layers, a sentinel-rollback test runner with test-database provisioning, a fresh-database migration runner, and migration-drift / view-dependency guards.",
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "effect",
    "postgres",
    "typescript"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-drizzle-ext#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-drizzle-ext/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-drizzle-ext.git",
    "directory": "packages/pg"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./migrations": "./src/migrations.ts",
    "./testing": "./src/testing.ts",
    "./tooling": "./src/tooling/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./migrations": {
        "types": "./dist/migrations.d.ts",
        "default": "./dist/migrations.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./tooling": {
        "types": "./dist/tooling/index.d.ts",
        "default": "./dist/tooling/index.js"
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/effect-drizzle-ext": "workspace:^"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@effect/sql-pg": "catalog:peers",
    "@testcontainers/postgresql": "catalog:peers",
    "drizzle-kit": "catalog:peers",
    "drizzle-orm": "catalog:peers",
    "effect": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@testcontainers/postgresql": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
