      },
      "./Derive": {
        "types": "./dist/Derive.d.ts",
        "default": "./dist/Derive.js"
      },
      "./Errors": {
        "types": "./dist/Errors.d.ts",
        "default": "./dist/Errors.js"
      },
      "./JsonApi": {
        "types": "./dist/JsonApi.d.ts",
        "default": "./dist/JsonApi.js"
      },
      "./JsonApiDerive": {
        "types": "./dist/JsonApiDerive.d.ts",
        "default": "./dist/JsonApiDerive.js"
      },
      "./PostGis": {
        "types": "./dist/PostGis.d.ts",
        "default": "./dist/PostGis.js"
      },
      "./Predicate": {
        "types": "./dist/Predicate.d.ts",
        "default": "./dist/Predicate.js"
      },
      "./Query": {
        "types": "./dist/Query.d.ts",
        "default": "./dist/Query.js"
