    "./Query": "./src/Query.ts",
    "./QueryFunctions": "./src/QueryFunctions.ts",
    "./References": "./src/References.ts",
    "./Search": "./src/Search.ts",
    "./Sort": "./src/Sort.ts",
    "./Update": "./src/Update.ts",
    "./VersionedChain": "./src/VersionedChain.ts",
    "./Where": "./src/Where.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./Annotation": {
        "types": "./dist/Annotation.d.ts",
        "default": "./dist/Annotation.js"
      },
      "./Columns": {
        "types": "./dist/Columns.d.ts",
        "default": "./dist/Columns.js"
      },
      "./Constraints": {
        "types": "./dist/Constraints.d.ts",
